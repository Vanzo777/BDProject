FROM apache/spark:4.0.1

USER root

# Обновите систему и установите необходимые пакеты
RUN apt-get update && \
    apt-get install -y software-properties-common curl gnupg2 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Установите Python 3.12 из deadsnakes PPA
RUN add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        python3-pip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Установите pip для Python 3.12
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12

# Установите необходимые Python пакеты
RUN python3.12 -m pip install --no-cache-dir \
    pyspark==4.0.1 \
    py4j

# Сделайте Python 3.12 версией по умолчанию
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 2 && \
    update-alternatives --set python3 /usr/bin/python3.12

# Создайте символическую ссылку для python
RUN ln -sf /usr/bin/python3.12 /usr/bin/python

# Проверьте установку
RUN python3 --version && \
    python3.12 --version && \
    python3 -m pip --version

USER spark

ENV PYSPARK_PYTHON=/usr/bin/python3.12
ENV PYSPARK_DRIVER_PYTHON=/usr/bin/python3.12
