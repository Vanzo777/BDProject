FROM apache/spark:4.0.1

USER root

# Обновите систему
RUN apt-get update && \
    apt-get install -y software-properties-common curl gnupg2 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Установите Python 3.12
RUN add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        python3-pip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Установите pip для Python 3.12
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12

# Установите Python пакеты включая Iceberg
RUN python3.12 -m pip install --no-cache-dir \
    pyspark==4.0.1 \
    py4j \
    pyiceberg[s3fs,pyarrow]==0.7.1

# ✅ Скачайте Iceberg JAR файлы для Spark 4.0 (Scala 2.13)
RUN curl -L https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-spark-runtime-3.5_2.13/1.7.1/iceberg-spark-runtime-3.5_2.13-1.7.1.jar \
    -o /opt/spark/jars/iceberg-spark-runtime-3.5_2.13-1.7.1.jar

RUN curl -L https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-aws-bundle/1.7.1/iceberg-aws-bundle-1.7.1.jar \
    -o /opt/spark/jars/iceberg-aws-bundle-1.7.1.jar

# ✅ Добавляем Hadoop AWS для S3
RUN curl -L https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.4.1/hadoop-aws-3.4.1.jar \
    -o /opt/spark/jars/hadoop-aws-3.4.1.jar

# ✅ ВАЖНО! AWS SDK Bundle для работы с S3
RUN curl -L https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar \
    -o /opt/spark/jars/aws-java-sdk-bundle-1.12.262.jar

# Сделайте Python 3.12 по умолчанию
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 2 && \
    update-alternatives --set python3 /usr/bin/python3.12

RUN ln -sf /usr/bin/python3.12 /usr/bin/python

# Проверка
RUN python3 --version && \
    python3.12 --version && \
    python3 -m pip --version

USER spark

ENV PYSPARK_PYTHON=/usr/bin/python3.12
ENV PYSPARK_DRIVER_PYTHON=/usr/bin/python3.12