# ============================================================================
# SQL AI Agent - Configuration Template
# ============================================================================
# 
# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
#
# Все параметры имеют дефолтные значения для локальной разработки.
# Для продакшена обновите значения в соответствии с вашей инфраструктурой.
# ============================================================================

# ============================================================================
# DATABASE SETTINGS
# ============================================================================
# Настройки подключения к PostgreSQL с аналитическими витринами

# Хост базы данных (localhost для разработки, IP/hostname для прода)
DB_HOST=localhost

# Порт PostgreSQL (стандартный 5432)
DB_PORT=5433

# Название базы данных
DB_NAME=mock_analytics

# Пользователь БД
DB_USER=user

# Пароль БД
DB_PASSWORD=123

# Схема БД где лежат таблицы (обычно public)
DB_SCHEMA=public

# ============================================================================
# LLM SETTINGS
# ============================================================================
# Настройки для работы с языковыми моделями через OpenRouter

# API ключ OpenRouter (получить на https://openrouter.ai/)
# ВАЖНО: Без этого ключа AI-агент не будет работать!
OPENROUTER_API_KEY=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

# Base URL для OpenRouter API (обычно не нужно менять)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Модель LLM для использования
# Рекомендуемые варианты:
#   - google/gemini-2.0-flash-exp:free        (быстрая, бесплатная)
#   - deepseek/deepseek-chat             (хорошее соотношение цена/качество)
#   - anthropic/claude-3.5-sonnet        (лучшее качество, дороже)
#   - openai/gpt-4-turbo                 (отличное качество, дорого)
#   - openai/gpt-3.5-turbo               (баланс цена/качество)
LLM_MODEL=google/gemini-2.0-flash-exp:free

# Temperature для генерации (0.0 = детерминированный, 2.0 = креативный)
# Для SQL рекомендуется 0.0-0.1 для стабильности
LLM_TEMPERATURE=0.0

# Максимальное количество токенов в ответе LLM
LLM_MAX_TOKENS=2000

# ============================================================================
# SEMANTIC LAYER SETTINGS
# ============================================================================
# Настройки семантического слоя с описаниями таблиц

# Путь к YAML файлу с описаниями таблиц
SEMANTIC_LAYER_PATH=config/semantic_layer.yaml

# Количество примеров запросов для few-shot learning (0-20)
# Больше примеров = лучше качество, но больше токенов
# Рекомендуется: 3-7 для баланса
FEW_SHOT_EXAMPLES_LIMIT=5

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Общие настройки приложения

# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# DEBUG - для разработки, INFO - для прода
LOG_LEVEL=INFO

# Логировать ли SQL запросы (true/false)
# Полезно для отладки и аудита
ENABLE_SQL_LOGGING=true

# Максимальное количество попыток исправить SQL при ошибке (1-10)
# LLM попытается исправить неверный SQL указанное количество раз
MAX_RETRY_ATTEMPTS=3

# Таймаут выполнения SQL запроса в секундах
# Защита от слишком долгих запросов
SQL_EXECUTION_TIMEOUT=30

# ============================================================================
# UI SETTINGS (STREAMLIT)
# ============================================================================
# Настройки веб-интерфейса

# Порт для Streamlit UI
STREAMLIT_PORT=8501

# Заголовок приложения
STREAMLIT_TITLE=SQL AI Agent

# ============================================================================
# PRODUCTION OVERRIDE EXAMPLE
# ============================================================================
# Раскомментируйте и заполните для продакшена:

# Продакшен БД от команды данных
# DB_HOST=prod-postgres.example.com
# DB_PORT=5432
# DB_NAME=analytics_prod
# DB_USER=ai_agent_user
# DB_PASSWORD=secure_password_here
# DB_SCHEMA=marts

# Другая LLM модель
# LLM_MODEL=deepseek/deepseek-chat
# LLM_TEMPERATURE=0.0

# Больше примеров для продакшена
# FEW_SHOT_EXAMPLES_LIMIT=7

# Логи для продакшена
# LOG_LEVEL=WARNING
# ENABLE_SQL_LOGGING=false

# ============================================================================
# NOTES
# ============================================================================
# 
# 1. Для локальной разработки:
#    - Используйте дефолтные значения (DB_HOST=localhost, etc.)
#    - Запустите docker-compose up -d для БД
#    - Установите свой OPENROUTER_API_KEY
#
# 2. Для продакшена:
#    - Получите доступы к БД от команды данных
#    - Обновите DB_* параметры
#    - Убедитесь что semantic_layer.yaml обновлён под реальные таблицы
#
# 3. Безопасность:
#    - Никогда не коммитьте .env файл в git!
#    - Используйте .env.example как шаблон
#    - Храните production credentials безопасно
#
# 4. Тестирование разных LLM:
#    - Просто меняйте LLM_MODEL на нужную модель
#    - Список доступных моделей: https://openrouter.ai/models
#
# ============================================================================