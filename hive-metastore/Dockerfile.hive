FROM apache/hive:4.0.0

USER root

# Устанавливаем curl
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Скачиваем PostgreSQL JDBC драйвер
RUN curl -L https://jdbc.postgresql.org/download/postgresql-42.7.4.jar \
    -o /opt/hive/lib/postgresql-jdbc.jar && \
    chmod 644 /opt/hive/lib/postgresql-jdbc.jar

# Скачиваем Hadoop AWS 3.3.6 (совместимая версия с Hadoop 3.3.x)
RUN curl -L https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.6/hadoop-aws-3.3.6.jar \
    -o /opt/hive/lib/hadoop-aws-3.3.6.jar && \
    chmod 644 /opt/hive/lib/hadoop-aws-3.3.6.jar

# Скачиваем AWS SDK Bundle
RUN curl -L https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar \
    -o /opt/hive/lib/aws-java-sdk-bundle-1.12.262.jar && \
    chmod 644 /opt/hive/lib/aws-java-sdk-bundle-1.12.262.jar

# Копируем конфигурацию
COPY conf/hive-site.xml /opt/hive/conf/hive-site.xml
COPY conf/core-site.xml /opt/hive/conf/core-site.xml

USER hive

# Игнорируем ошибки инициализации если схема уже существует
ENTRYPOINT ["bash", "-lc", "\
/opt/hive/bin/schematool -dbType postgres -initSchema 2>&1 | grep -v 'already exists' || true; \
/opt/hive/bin/hive --service metastore -p 9083 \
"]
